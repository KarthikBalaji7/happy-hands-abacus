# Optional environment variables for Netlify Serverless Function (contact/enrollment)

# Contact form recipient email (defaults to admissions@happyhandseducation.com if unset)
CONTACT_RECIPIENT_EMAIL=admissions@happyhandseducation.com

# Resend API Key for automatic email delivery (optional)
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=Happy Hands <notifications@happyhandseducation.com>

# Optional Webhook notifications (Discord / Slack)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
