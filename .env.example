
# 1. SMTP Server Connection Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# 2. SMTP Authentication
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# 3. Email Recipients & Defaults (Optional)
# Where to receive form notification emails (defaults to admissions@happyhandseducation.com if omitted)
CONTACT_RECIPIENT_EMAIL=admissions@happyhandseducation.com

# Timezone for notification timestamps (defaults to Indian/Maldives)
TIMEZONE=Indian/Maldives
